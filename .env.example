HOST=127.0.0.1
# En el servidor usa production: exige HTTPS y OAuth antes de arrancar.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DB_PATH=./data/chronix.sqlite
# Los tres valores siguientes activan Google y la sincronización.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_KEY=
# Correo verificado de la única cuenta que puede iniciar sesión.
CHRONIX_OWNER_EMAIL=
# Usa false para ofrecer solo el inicio de sesión mientras preparas Calendar.
GOOGLE_CALENDAR_ENABLED=true
