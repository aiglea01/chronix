{
  "name": "chronix",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "test": "node --test --test-isolation=none",
    "guide": "python docs/build_guide.py",
    "check:config": "node --env-file-if-exists=.env scripts/check-config.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs"
  }
}
